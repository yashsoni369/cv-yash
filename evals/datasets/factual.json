{
  "name": "factual_accuracy",
  "description": "Checks that Yash answers with facts from the vault (Yash Soni hub, company and project hubs)",
  "tests": [
    {
      "id": "exp-years",
      "description": "Experience since Jan 2017, so 9+ years",
      "input": "How many years of experience do you have?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["9+", "nine", "2017", "9 years"] },
        { "type": "not_contains", "value": "8+" }
      ]
    },
    {
      "id": "location",
      "description": "Based in Mumbai",
      "input": "Where are you based?",
      "lang": "en",
      "assertions": [
        { "type": "contains", "value": "Mumbai" }
      ]
    },
    {
      "id": "decoverai-role",
      "description": "Contractor who helped build the platform; $2M+ seed, not a co-founder or valuation",
      "input": "What was your role at DecoverAI?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["infrastructure", "GenAI", "platform", "contract"] },
        { "type": "not_contains", "value": "co-founded" },
        { "type": "not_contains", "value": "valuation" }
      ]
    },
    {
      "id": "decoverai-funding",
      "description": "DecoverAI raised $2M+ seed",
      "input": "How much funding did DecoverAI raise?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["$2M", "2M", "two million"] }
      ]
    },
    {
      "id": "speakology-schools",
      "description": "10+ UK schools in 3 months, never 600+",
      "input": "How many schools use Speakology?",
      "lang": "en",
      "assertions": [
        { "type": "contains", "value": "10" },
        { "type": "not_contains", "value": "600" }
      ]
    },
    {
      "id": "lti-team",
      "description": "Led a COE of 10+ engineers at LTI Mindtree",
      "input": "What did you do at LTI Mindtree?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["10+", "COE", "DevOps"] }
      ]
    },
    {
      "id": "llm-model",
      "description": "The chat runs on Gemini, never Claude",
      "input": "What model powers this chat?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["Gemini", "gemini"] },
        { "type": "not_contains", "value": "Claude" }
      ]
    },
    {
      "id": "mappie-client",
      "description": "Mappie AI was built for Nindo Solutions",
      "input": "Who is Mappie AI built for?",
      "lang": "en",
      "assertions": [
        { "type": "contains", "value": "Nindo" }
      ]
    },
    {
      "id": "own-products",
      "description": "Own product line",
      "input": "What products have you shipped yourself?",
      "lang": "en",
      "assertions": [
        { "type": "contains_any", "values": ["BrandGen", "TriageGrid", "Convo AI", "CC Logins"] }
      ]
    },
    {
      "id": "no-dbiz",
      "description": "DBiz AI must never be mentioned",
      "input": "List every company you have worked for.",
      "lang": "en",
      "assertions": [
        { "type": "not_contains", "value": "DBiz" },
        { "type": "contains_any", "values": ["LTI Mindtree", "Azentio", "Abacus", "Threepin"] }
      ]
    }
  ]
}
